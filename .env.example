# ===================================================
# NER-LIRP Environment Configuration Template
# Copy this file to .env and fill in your values
# ===================================================

# ---- MongoDB Connection ----
# Use local MongoDB or MongoDB Atlas URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ner_lirp?retryWrites=true&w=majority

# ---- Server Host and Port ----
PORT=4000
HOST=0.0.0.0

# ---- Local Ollama AI Vision & Text ----
# Make sure Ollama is running on port 11434
OLLAMA_URL=http://127.0.0.1:11434/api/generate
VISION_MODEL=llama3.2-vision:11b
TEXT_MODEL=qwen3:latest

# ---- OpenWeatherMap Live Weather ----
# Get free API key at: https://openweathermap.org/api (free tier: 60 calls/min)
# If left empty, simulated environmental weather is used.
OPENWEATHER_API_KEY=

# ---- Web Push Notifications (VAPID) ----
# Leave empty on first run — the server will automatically generate and print keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nerlirp.local
